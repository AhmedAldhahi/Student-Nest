{
  "entryPoints": [
    "./src/Core/entites",
    "./src/Core/value-object",
    "./src/Core/enum",
    "./src/Core/repositories"
  ],
  "entryPointStrategy": "expand",
  "out": "src/Presentation/documentation/Typedoc",
  "includeVersion": true,
