{
  "compilerOptions": {
    /* Language & Project */
    "target": "ES2020",                  /* Modern JS output */
    "module": "commonjs",
    "rootDir": "./src",                  /* Keep source files organized */
    "outDir": "./dist",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    /* Module Resolution */
    "moduleResolution": "node10",        /* Modern Node resolution */
    "ignoreDeprecations": "6.0",         /* Silence TS6 deprecation warnings */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,           /* Allow importing .json files */
    "types": ["node"],

    /* Type Checking */
    "strict": true,
    "noImplicitAny": true,
    "strictPropertyInitialization": false,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "allowUnreachableCode": false,

    /* Emit */
    "removeComments": true,
    "noEmitOnError": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
